# Lawyers Zone — backend configuration.
# Copy to backend/.env and adjust. Never commit backend/.env.

# Bind address. Keep 127.0.0.1 so the API is local-only by default.
DL_HOST=127.0.0.1
DL_PORT=8001

# SQLite database file (created automatically).
DL_DB_PATH=data.db

# Comma-separated allowed frontend origins (CORS).
DL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Groq API key — server-side only, never exposed to the frontend.
# Create a key at https://console.groq.com/keys and paste it here.
GROQ_API_KEY=

# Chat model. llama-3.3-70b-versatile was retired by Groq; gpt-oss-120b is the default.
GROQ_MODEL=openai/gpt-oss-120b