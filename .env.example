# Frontend environment (Vite exposes only VITE_* vars to the client).
# Base URL of the FastAPI backend (Phase 2+). No secrets here.
# Leave empty to call the relative /api path: served by the Vercel serverless
# function in production, and proxied to the local backend in dev (vite.config.ts).
VITE_API_BASE_URL=

# IMPORTANT: AI provider API keys are NEVER stored in the frontend or committed.
# They are configured server-side via backend/.env in Phase 3.